# guides-api configuration.
#
# Copy to `.env.development` for local work. Production must NOT use a .env file — the
# deploy workflow writes these as real environment variables from a GitHub Environment.
# Every key is prefixed `GD_` except the two that are conventionally unprefixed.

APP_ENV=development

# --- database ----------------------------------------------------------------
GD_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/guides_api
GD_DATABASE_POOL_SIZE=20
GD_DATABASE_MAX_OVERFLOW=10
GD_DATABASE_POOL_TIMEOUT=30
# Refuse to boot unless the database is at the alembic head. Leave true in production.
GD_DATABASE_REQUIRE_MIGRATION_HEAD=true

# Migrations only. Set as a step-level variable at deploy time, not in the service's
# environment, so the migration role and the runtime role can differ.
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://migrator:...@localhost:5432/guides_api

# --- asset storage -----------------------------------------------------------
# Sketches, redrawn SVGs, and rendered PDFs. Content-addressed; back this up.
GD_ASSET_ROOT=./var/assets
GD_MAX_UPLOAD_BYTES=20971520

# --- sketch redraw -----------------------------------------------------------
GD_SKETCH_ENABLED=true
ANTHROPIC_API_KEY=
GD_SKETCH_MODEL=claude-opus-5
GD_SKETCH_EFFORT=high
GD_SKETCH_MAX_TOKENS=32000
GD_SKETCH_TIMEOUT_SECONDS=300
# Which house-style prompt to use. Recorded on every job, so a restyle is traceable.
GD_SKETCH_PROMPT_VERSION=blueprint-v1

# --- rendering / house style -------------------------------------------------
# Recorded on every render. Bump it when the template changes so a PDF in the wild can
# be traced to the template that produced it, not just to its revision.
GD_TEMPLATE_VERSION=blueprint-1.0
GD_PAGE_SIZE=letter
GD_SHEET_ORGANISATION=Eldritch County
GD_SHEET_DEPARTMENT=Metrology Standards Office
GD_SHEET_DOCUMENT_KIND=Procedure Sheet
# Transparent PNG or SVG. `mix-blend-mode` is unreliable in WeasyPrint, so a logo with a
# white box behind it will print with the box.
# GD_SHEET_LOGO_PATH=/srv/guides-api/logo.svg
GD_SHEET_FRAME_WEIGHT=standard
GD_SHEET_PLATE_GRID=true
GD_SHEET_REGISTRATION_MARKS=true
# `{doc_number}` is substituted. Empty disables the QR panel on the record page.
GD_SHEET_SUPPORT_URL_TEMPLATE=

# --- observability -----------------------------------------------------------
GD_LOG_LEVEL=info
GD_CONSOLE_LOG_LEVEL=info
# Absent means "do not send", not "fail".
LOGFIRE_TOKEN=
GD_LOGFIRE_FOR_SQLALCHEMY=false
